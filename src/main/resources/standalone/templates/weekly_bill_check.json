{
  "templateId": "weekly_bill_check",
  "version": 1,
  "name": "Weekly bill check",
  "description": "Read this week's bills",
  "trigger": { "type": "schedule" },
  "action": {
    "type": "bill.read",
    "previewIntent": "bill.read",
    "executeIntent": "bill.read"
  },
  "mode": "READ",
  "paramSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "account": { "type": "string", "pattern": "^acct_tok_[A-Za-z0-9]+$" }
    }
  },
  "limits": { "maxAmount": null, "maxRunsPerDay": null, "maxRunsPerPeriod": null },
  "requiredTools": ["bill.read"],
  "approvalTtl": "PT24H",
  "effectText": "Show the bills due this week.",
  "status": "approved",
  "reviewedBy": "standalone",
  "reviewedAt": "2026-01-01T00:00:00Z"
}
